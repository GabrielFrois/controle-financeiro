# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/controle_financeiro

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por vírgula das origens permitidas.
# Deixe vazio para aceitar qualquer origem (útil em desenvolvimento).
# Em produção, defina explicitamente: http://meuapp.com,https://meuapp.com
ALLOWED_ORIGINS=http://localhost:5173

# ── APIs de cotação ───────────────────────────────────────────────────────────
HG_TOKEN=seu_token_hg_brasil_aqui
